<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>ASP.NET Core integration for ApricotFramework.DataProtection: an IDeletableXmlRepository over the key store, PersistKeysTo extensions on IDataProtectionBuilder, and the application discriminator bound from configuration. Leaves at-rest key encryption and key lifetime to the host, so every framework extension point still composes.</Description>
    <PackageTags>dataprotection;keyring;aspnetcore;dependencyinjection;xmlrepository</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.DataProtection/ApricotFramework.DataProtection.csproj" />
  </ItemGroup>

</Project>
